// C3CImageSize resource script
//
// Modern Photoshop plugins carry their PiPL as a JSON resource
// named "JSON_PIPL" of type 'JSON' (see the SDK "PiPL Resources" docs).

JSON_PIPL JSON "..\C3CImageSize\PiPLs.json"

// Plug-in icon (shown in the Photoshop menus and Windows Explorer)
1 ICON "C3CImageSize.ico"
